{
  "manifest_version": 2,
  "name": "bigAL",
  "version": "0.1.0",
  "description": "Enhanced studio pages, a global profile accent and opening/ending themes on AniList.",
  "permissions": [
    "storage",
    "https://graphql.anilist.co/*",
    "https://graphql.animethemes.moe/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://anilist.co/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
